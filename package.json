{
  "name": "mindcare-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "content:check": "node --import tsx scripts/check-content.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "yarn content:check && yarn typecheck && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "vue": "3.5.42",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "tsx": "4.23.13",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vue-tsc": "3.3.11",
    "workbox-window": "^7.4.1",
    "workbox-build": "^7.4.1"
  }
}
